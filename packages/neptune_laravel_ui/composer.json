{
    "name": "neptune-fintech/laravel-ui",
    "description": "Neptune Odyssey for Laravel — Blade components over the framework-agnostic web kit, plus vendored assets so a Laravel app needs no Node/npm build step for the four reference brands.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://neptune.ly",
    "authors": [
        { "name": "Neptune.Fintech", "homepage": "https://neptune.ly" }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Neptune\\Ui\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Neptune\\Ui\\NeptuneUiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
