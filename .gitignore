# deps
node_modules/
.pnpm-store/

# build outputs
dist/
# ...except neptune_laravel_ui's dist, which is a deliberately vendored,
# checked-in copy of neptune_web_ui's build (Composer can't resolve an npm
# package's output at install time) — see that package's README/tools/sync-assets.mjs.
!packages/neptune_laravel_ui/resources/dist/
!packages/neptune_laravel_ui/resources/dist/**
build/web/
*.tsbuildinfo
coverage/

# dart / flutter (note: the repo's TOP-LEVEL build/ is source-of-truth — do NOT ignore it;
# only the Flutter package's build output is ignored)
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
**/doc/api/
packages/neptune_flutter_ui/build/
packages/neptune_sound_kit/build/
packages/neptune_kmp_ui/build/

# editor / os
.DS_Store
.idea/
.vscode/
*.log

# misc
extracted/

# local Pages preview assembly
_site/

# tools/sound-identity: generated WAV families + mp3 preview builds
# (regenerate with `node generate.mjs --name ...`, never hand-edited)
tools/sound-identity/output/
tools/sound-identity/preview/listening_room.html

# generated docs bundle (built by site/bundle/build.mjs in CI)
site/assets/neptune.js

# Local-only client prototypes (logos + demos never enter the public repo)
**/lib/client_*
**/assets/client_*
